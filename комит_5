import tkinter as tk
from tkinter import messagebox

# Константы дизайн-системы из предыдущих коммитов
C_BG = "#13271F"
C_PANEL = "#224A36"
C_GOLD = "#E6C27A"
C_TEXT = "#F8F9FA"
C_BTN_RED = "#922B21"
C_BTN_RED_H = "#B03A2E"
FONT_H1 = ("Segoe UI", 16, "bold")
FONT_P = ("Segoe UI", 12)

# Метод создания скруглений и класс ModernButton импортируются из Коммита 4 без изменений

class BlackjackApp(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Blackjack")
        self.geometry("1100x800")
        self.configure(bg=C_BG)
        
        # Привязка глобальной горячей клавиши F11 для перехода в Fullscreen
        self.bind("<F11>", lambda e: self.attributes("-fullscreen", not self.attributes("-fullscreen")))
        
        self.balance = 1000
        self.current_bet = tk.IntVar(value=50)
        self.bot_count = tk.IntVar(value=1)
        
        self.show_menu_placeholder()

    def clear(self):
        for widget in self.winfo_children(): widget.destroy()

    def show_menu_placeholder(self):
        self.clear()
        # Для демонстрации окна правил создаем кнопку вызова в текущем фрейме
        btn_frame = tk.Frame(self, bg=C_BG)
        btn_frame.pack(expand=True)
        
        # Кнопка правил
        tk.Button(btn_frame, text="ОТКРЫТЬ ПРАВИЛА", font=FONT_P, command=self.show_rules).pack(pady=10)

    def show_rules(self):
        """Создание независимого дочернего модального окна правил игры"""
        rules_win = tk.Toplevel(self)
        rules_win.title("Правила игры")
        rules_win.geometry("500x400")
        rules_win.configure(bg=C_BG)
        rules_win.resizable(False, False)

        # Обеспечение модальности окна (блокировка родительского меню)
        rules_win.transient(self)
        rules_win.grab_set()

        tk.Label(rules_win, text="ПРАВИЛА BLACKJACK", font=FONT_H1, bg=C_BG, fg=C_GOLD).pack(pady=10)

        # Контейнер для текстового поля и скроллбара
        text_frame = tk.Frame(rules_win, bg=C_BG)
        text_frame.pack(padx=20, pady=10, fill="both", expand=True)

        scrollbar = tk.Scrollbar(text_frame)
        scrollbar.pack(side="right", fill="y")

        # Инкапсуляция текста правил внутрь tk.Text
        rules_text_widget = tk.Text(text_frame, font=FONT_P, bg=C_BG, fg=C_TEXT, wrap="word",
                                    yscrollcommand=scrollbar.set, bd=0, highlightthickness=0)
        rules_text_widget.pack(side="left", fill="both", expand=True)
        scrollbar.config(command=rules_text_widget.yview)

        rules_text_content = (
            "1. Цель игры — набрать сумму очков, близкую к 21.\n\n"
            "2. Числовые карты дают очки по номиналу. Картинки (J, Q, K) — 10 очков.\n\n"
            "3. Туз (A) дает 11 или 1 очко (правило мягкого Туза)."
        )
        rules_text_widget.insert("1.0", rules_text_content)
        rules_text_widget.config(state="disabled")  # Принудительная блокировка редактирования текста

        # Кнопка закрытия окна
        tk.Button(rules_win, text="ЗАКРЫТЬ", command=rules_win.destroy, bg=C_BTN_RED, fg=C_TEXT).pack(pady=15)

if __name__ == "__main__":
    app = BlackjackApp()
    app.mainloop()
